[Desktop Entry]
Type=Application
Name=Lubus
GenericName=Bootable USB Creator
Comment=Create bootable USB drives from ISO images
Exec=@PYTHON@ -m @MODULE@ %F
Icon=com.github.yourusername.lubus
Terminal=false
Categories=System;Utility;
MimeType=application/x-iso9660-image;application/octet-stream;
Keywords=usb;bootable;iso;rufus;flash;dd;
StartupNotify=true
StartupWMClass=com.github.yourusername.lubus