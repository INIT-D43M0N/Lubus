  <releases>
    <release version="6.1.0" date="@VERSION_DATE@">
      <description>Yaku 6.1 is the new name of the project. The application,
      the package, the icons and the app id all follow the rename, and the
      project now lives at https://github.com/INIT-D43M0N/Yaku</description>
    </release>
    <release version="6.0.0" date="2026-11-10">
      <description>Yaku 6.0 writes ChromeOS and macOS images and supports the
      BSDs and the other Unixes. A ChromeOS recovery image can now be turned
      into a Brunch install, which runs ChromeOS on a regular computer.</description>
    </release>
    <release version="5.0.0" date="2026-11-10">
      <description>Yaku 5.0 adds direct drive installation (portable mode)
      with automatic/custom partitioning and user provisioning, plus
      simultaneous flashing to multiple drives.</description>
    </release>
    <release version="1.0.0" date="2026-11-04">
      <description>Initial release</description>
    </release>
  </releases>
