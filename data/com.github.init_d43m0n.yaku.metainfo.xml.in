<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.init_d43m0n.yaku</id>
  <name>Yaku</name>
  <summary>Create bootable USB drives from ISO images</summary>
  <description>
    <p>Yaku is a modern, native Linux application for creating bootable USB drives, functionally identical to Rufus but built specifically for the Linux ecosystem.</p>
    <p>Features:</p>
    <ul>
      <li>Automatic detection of removable USB drives and SD cards</li>
      <li>Support for ISO, IMG, DD, RAW, BIN and DMG images</li>
      <li>Automatic detection of the image type (Windows, Linux, ChromeOS, macOS, BSD)</li>
      <li>Windows installer media creation, Windows To Go and driver staging</li>
      <li>ChromeOS recovery images, with optional Brunch for regular computers</li>
      <li>macOS installer disk images (EFI + HFS+ layout)</li>
      <li>FreeBSD, OpenBSD, NetBSD, DragonFly BSD, illumos and Haiku media</li>
      <li>Partition scheme selection (GPT/MBR) and target system (UEFI/BIOS)</li>
      <li>Filesystem selection (FAT32, NTFS, exFAT, ext4, btrfs)</li>
      <li>DD mode (block copy) and ISO extract mode</li>
      <li>Real-time progress with speed and ETA</li>
      <li>Optional verification after write</li>
      <li>Direct drive installation / portable mode (Windows and Linux)</li>
      <li>Simultaneous flashing to multiple drives</li>
      <li>Integrated Linux ISO catalog and segmented verified downloader</li>
      <li>Safety checks and confirmation dialogs</li>
    </ul>
  </description>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>Yaku Contributors</developer_name>
  <url type="homepage">https://github.com/INIT-D43M0N/Yaku</url>
